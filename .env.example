# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key (LLM)
ANTHROPIC_API_KEY=

# OpenAI API key (embeddings, text-embedding-3-small)
OPENAI_API_KEY=

# Supabase project URL
SUPABASE_URL=
# Supabase SECRET key (not the public anon/publishable key). Backend only.
SUPABASE_SECRET_KEY=

# Pinecone API key and the name of your index (1536 dimensions, cosine)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
